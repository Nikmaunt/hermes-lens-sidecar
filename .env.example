# hermes-lens-sidecar configuration.
# Copy to .env next to package.json, then: chmod 600 .env
# The sidecar loads this file itself (no dotenv dependency); real environment
# variables take precedence over values here.

# REQUIRED. Static bearer token the Lens app sends. Generate with:
#   openssl rand -hex 32
# Never reuse the agent's own secrets from ~/.hermes/.env.
LENS_TOKEN=

# Where to listen. Keep 127.0.0.1 — TLS + tailnet exposure is done by
# `tailscale serve`, the sidecar must never bind a public interface.
LENS_BIND=127.0.0.1
LENS_PORT=8787

# Agent data (read-only for the sidecar, except the vault write paths
# documented in README).
VAULT_DIR=/home/nick/vault
HERMES_DIR=/home/nick/.hermes
BACKUPS_DIR=/home/nick/backups

# Sidecar-private state: clientId dedup ledger + write journal + chat job buffer.
DATA_DIR=/home/nick/hermes-lens-sidecar/data

# Filesystem whose usage is reported in /api/status.
DISK_PATH=/

# ── Chat proxy (POST /api/chat, GET /api/chat/{jobId}) ───────────────────────
# The sidecar forwards chat turns to the agent's OpenAI-compatible server on
# loopback, hiding the latency and this upstream key from the app.
#
# REQUIRED for chat. Copy the agent's API_SERVER_KEY value from ~/.hermes/.env
# into HERE — the sidecar keeps its own copy and never reads the agent's env
# file (that read-only boundary is pinned by the write-restriction test). If
# left empty, /api/chat returns 503 and every other endpoint keeps working.
API_SERVER_KEY=

# Where the agent's API server listens (loopback only; never expose it).
AGENT_API_URL=http://127.0.0.1:8642
# Model the agent server serves.
CHAT_MODEL=deepseek/deepseek-v4-pro
# Hard budget for one agent turn before the sidecar gives up (ms). Agent tasks
# run 30–120 s, so keep well above that.
CHAT_TURN_BUDGET_MS=180000
# How long a finished/failed turn stays pollable, and how far back a session's
# rolling dialog context reaches (ms).
CHAT_JOB_TTL_MS=600000
# Max prior turns replayed as rolling context on a session.
CHAT_HISTORY_MAX_TURNS=12
